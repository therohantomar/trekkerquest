---
import "@fontsource/poppins/300.css";
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/800.css";
import "@fontsource/literata/400.css";
import "@fontsource/literata/600.css";
import "@fontsource/plus-jakarta-sans/400.css";
import "@fontsource/plus-jakarta-sans/500.css";
import "@fontsource/plus-jakarta-sans/600.css";
import "@fontsource/plus-jakarta-sans/700.css";
import "@fontsource/urbanist/600.css";
import "@fontsource/urbanist/700.css";
import "@fontsource/urbanist/800.css";
import "aos/dist/aos.css";
const {
  title = "TrekkersQuest — Find Your Trail. Live Your Quest.",
  description = "Discover trekking landscapes across India. Compare trails, understand preparation, and plan your next adventure.",
} = Astro.props;
const nav = [
  { label: "Explore treks", href: "/treks/" },
  { label: "Destinations", href: "/destinations/" },
  { label: "Weekend trails", href: "/weekend-treks/" },
  { label: "Trail journal", href: "/blog/" },
  { label: "About", href: "/about/" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#275123" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/trekkers-quest-mark.svg" />
    <link rel="shortcut icon" href="/trekkers-quest-mark.svg" />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="header">
      <a class="brand" href="/" aria-label="Trekker’s Quest home">
        <img class="brand-mark" src="/trekkers-quest-mark.svg" alt="" />
        <span class="brand-copy">
          <span class="brand-wordmark">Trekker’s Quest</span>
          <span class="brand-tagline">Adventure awaits!</span>
        </span>
      </a>
      <button
        class="menu-toggle"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="site-nav"
      >
        <iconify-icon
          icon="solar:hamburger-menu-linear"
          aria-hidden="true"
        ></iconify-icon>
      </button>
      <nav id="site-nav" aria-label="Main navigation">
        <div class="nav-links">
          {nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </div>
        <a class="button button-small" href="/treks/">
          Find your trek <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="footer-top">
        <div>
          <a
            class="brand footer-brand"
            href="/"
            aria-label="Trekker’s Quest home"
          >
            <img class="brand-mark" src="/trekkers-quest-mark.svg" alt="" />
            <span class="brand-copy">
              <span class="brand-wordmark">Trekker’s Quest</span>
              <span class="brand-tagline">Adventure awaits!</span>
            </span>
          </a>
          <p>
            India, one trail at a time.
            <br />A discovery guide for curious feet.
          </p>
        </div>
        <div>
          <h3>Explore</h3>
          <a href="/treks/">All treks</a>
          <a href="/destinations/">Destinations</a>
          <a href="/weekend-treks/">Weekend trails</a>
          <a href="/blog/">Trail journal</a>
        </div>
        <div>
          <h3>About</h3>
          <a href="/about/">Our approach</a>
          <a href="/contact/">Contact</a>
          <a href="/faq/">FAQs</a>
        </div>
        <div>
          <h3>Good to know</h3>
          <a href="/privacy-policy/">Privacy (draft)</a>
          <a href="/terms-and-conditions/">Terms (draft)</a>
          <a href="/cancellation-policy/">Cancellation (draft)</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} TrekkersQuest</span>
        <span>Demo discovery content. Verify route details before travel.</span>
      </div>
    </footer>
    <script>
      import AOS from "aos";
      import "iconify-icon";
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const revealSelector = [
        "main .page-hero",
        "main .detail-hero",
        ".home-hero .hero-copy > *",
        ".home-hero .hero-image",
        "main .trust-strip > *",
        "main .section-head",
        "main .section > h2",
        "main .section > p",
        "main .section > .card-grid",
        "main .section > .region-grid",
        "main .section > .city-links",
        "main .section > .contact-form",
        "main .section > details",
        "main .trek-card",
        "main .region-card",
        "main .principles > div",
        "main .city-links > a",
        "main .article > *",
        "main .detail-content > h2",
        "main .detail-content > p",
        "main .detail-content > ul",
        ".footer-top > div",
        ".footer-bottom",
      ].join(",");
      const revealTargets = Array.from(
        document.querySelectorAll(revealSelector),
      );
      if (!reduceMotion) {
        revealTargets.forEach((element, index) => {
          const bounds = element.getBoundingClientRect();
          if (bounds.top >= window.innerHeight) {
            element.setAttribute("data-aos", "fade-up");
            element.setAttribute("data-aos-duration", "650");
            element.setAttribute("data-aos-delay", String((index % 4) * 55));
          }
        });
      }
      AOS.init({
        duration: 650,
        easing: "ease-out-cubic",
        once: true,
        offset: 90,
        disable: reduceMotion,
      });
      const toggle = document.querySelector(".menu-toggle");
      const nav = document.querySelector("#site-nav");
      toggle?.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!open));
        toggle.setAttribute(
          "aria-label",
          open ? "Open navigation" : "Close navigation",
        );
        toggle
          .querySelector("iconify-icon")
          ?.setAttribute(
            "icon",
            open ? "solar:hamburger-menu-linear" : "solar:close-circle-linear",
          );
        nav?.classList.toggle("nav-open", !open);
      });
    </script>
  </body>
</html>
<style is:global>
  :root {
    --crimson-50: #fbecec;
    --crimson-200: #ebb5b5;
    --crimson-500: #8f0a0b;
    --crimson-700: #6e0708;
    --crimson-900: #3f0405;
    --pine-50: #e8f0e6;
    --pine-200: #a9c7a4;
    --pine-500: #275123;
    --pine-700: #1b3a18;
    --pine-900: #0e2010;
    --gold-50: #fdf4e0;
    --gold-200: #f8dca0;
    --gold-500: #eda525;
    --gold-700: #b97a0c;
    --gold-900: #6b4505;
    --ridge-50: #f6efe3;
    --ridge-200: #dcc59b;
    --ridge-500: #9a722a;
    --ridge-700: #6f5019;
    --ridge-900: #3e2c0e;
    --forest: var(--pine-500);
    --pine: var(--pine-500);
    --cream: #ffffff;
    --sand: #f2eee7;
    --orange: var(--crimson-500);
    --ink: #14100c;
    --muted: #5a5046;
    --white: #fff;
    --line: #e2dcd1;
    --serif: "Literata", Georgia, serif;
    --body: "Plus Jakarta Sans", system-ui, sans-serif;
    --display: "Urbanist", "Poppins", system-ui, sans-serif;
    --brand-font: "Poppins", system-ui, sans-serif;
    --gold-contrast: #14100c;
  }
  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    background: var(--cream);
    color: var(--ink);
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.6;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  button,
  input,
  select,
  textarea {
    font: inherit;
  }
  a:focus-visible,
  button:focus-visible,
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 3px solid var(--pine-500);
    outline-offset: 3px;
  }
  .skip {
    position: absolute;
    top: -60px;
    left: 12px;
    background: white;
    padding: 10px;
    z-index: 9;
  }
  .skip:focus {
    top: 8px;
  }
  .header {
    height: 90px;
    padding: 0 clamp(22px, 6vw, 96px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--cream);
    position: relative;
    z-index: 4;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--forest);
    text-decoration: none;
  }
  .brand-mark {
    display: block;
    flex: none;
    width: 52px;
    height: 38px;
    padding: 2px 3px;
    border-radius: 8px;
    background: #fff;
    object-fit: contain;
  }
  .brand-copy {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .brand-wordmark {
    font: 800 14px/1.15 var(--brand-font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .brand-tagline {
    font: 300 10px/1.2 var(--brand-font);
    letter-spacing: 0.1em;
  }
  .footer-brand .brand-tagline {
    color: #f2eee7;
  }
  .header nav {
    display: flex;
    align-items: center;
    gap: 34px;
  }
  .nav-links {
    display: flex;
    gap: 27px;
  }
  .nav-links a {
    font-family: var(--body);
    font-size: 13px;
    font-weight: 600;
  }
  .nav-links a:hover {
    color: var(--pine);
  }
  .menu-toggle {
    display: none;
  }
  .button {
    display: inline-flex;
    gap: 11px;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 23px;
    border: 1px solid transparent;
    border-radius: 8px;
    background: var(--crimson-500);
    color: white;
    font: 600 14px/1 var(--body);
    letter-spacing: 0.1px;
    box-shadow:
      0 5px 14px rgba(143, 10, 11, 0.19),
      inset 0 1px 0 rgba(255, 255, 255, 0.16);
    cursor: pointer;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
  }
  .button:hover {
    transform: translateY(-2px);
    background: var(--crimson-700);
    box-shadow: 0 9px 20px rgba(143, 10, 11, 0.25);
  }
  .button:active {
    transform: translateY(0) scale(0.98);
  }
  .button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }
  .button-small {
    min-height: 44px;
    padding: 0 19px;
    font-size: 13px;
  }
  .button-outline {
    border: 2px solid var(--crimson-500);
    color: var(--crimson-500);
    background: transparent;
    box-shadow: none;
  }
  .button-gold {
    background: var(--gold-500);
    color: var(--gold-contrast);
    box-shadow: 0 5px 14px rgba(109, 69, 5, 0.16);
  }
  .button-gold:hover {
    background: var(--gold-700);
    color: var(--gold-contrast);
  }
  .button-outline:hover {
    background: var(--crimson-50);
    color: var(--crimson-700);
    box-shadow: 0 5px 14px rgba(143, 10, 11, 0.09);
  }
  .hero-actions .button-outline {
    border-color: rgba(255, 255, 255, 0.8);
    color: #fff;
    background: rgba(20, 16, 12, 0.2);
  }
  .hero-actions .button-outline:hover {
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
  }
  .trail-slider {
    position: relative;
    min-height: 420px;
    margin: 28px 0 18px;
    overflow: hidden;
    border-radius: 24px;
    background: var(--pine-900);
  }
  .slider-slide {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: clamp(28px, 6vw, 72px);
    background-position: center;
    background-size: cover;
    color: white;
  }
  .slider-kicker {
    font: 600 11px var(--body);
    letter-spacing: 1.8px;
    color: var(--gold-200);
    text-transform: uppercase;
  }
  .slider-title {
    display: block;
    max-width: 680px;
    margin: 15px 0 10px;
    font: 800 clamp(32px, 5vw, 58px)/1.08 var(--display);
    letter-spacing: -1.8px;
  }
  .slider-description {
    max-width: 540px;
    font: 17px/1.65 var(--serif);
    color: #f3f1e9;
  }
  .slider-link {
    margin-top: 22px;
    font: 600 13px var(--body);
  }
  .slider-controls {
    position: absolute;
    z-index: 2;
    bottom: 20px;
    right: 20px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .slider-controls button {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: white;
    color: var(--pine-900);
    cursor: pointer;
  }
  .slider-controls iconify-icon {
    font-size: 19px;
  }
  .slider-dots {
    display: flex;
    gap: 7px;
  }
  .slider-dots button {
    width: 8px;
    height: 8px;
    min-width: 8px;
    min-height: 8px;
    padding: 0;
    background: #ffffff91;
  }
  .slider-dots button[aria-current="true"] {
    background: var(--gold-500);
    transform: scale(1.25);
  }

  .footer {
    background: var(--forest);
    color: #f3f5ef;
    padding: 72px clamp(24px, 8vw, 124px) 30px;
  }
  .footer-top {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 36px;
    padding-bottom: 42px;
  }
  .footer-brand {
    color: white;
  }
  .footer p {
    color: #c7d2ca;
    font-size: 14px;
  }
  .footer h3 {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 1.1px;
    margin: 4px 0 18px;
  }
  .footer-top > div:not(:first-child) {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .footer-top a:not(.brand) {
    font-size: 13px;
    color: #d7e0d9;
  }
  .footer-bottom {
    border-top: 1px solid #456355;
    padding-top: 18px;
    display: flex;
    justify-content: space-between;
    color: #becdc2;
    font-size: 12px;
  }
  .eyebrow {
    font-size: 11px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--pine);
  }
  h1,
  h2,
  h3 {
    font-family: var(--display);
    letter-spacing: -1.5px;
    line-height: 1.08;
  }
  h1 {
    font-size: clamp(43px, 6vw, 76px);
    margin: 16px 0;
  }
  h2 {
    font-size: clamp(32px, 4vw, 48px);
    margin: 0 0 14px;
  }
  p {
    color: var(--muted);
  }
  .section {
    padding: 100px clamp(24px, 8vw, 124px);
  }
  .section-head {
    max-width: 610px;
    margin-bottom: 34px;
  }
  .section-head p {
    margin: 0;
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .trek-card {
    background: white;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: 0 12px 30px rgba(28, 86, 55, 0.07);
  }
  .trek-card img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
  }
  .trek-card-body {
    padding: 23px;
  }
  .trek-card .eyebrow {
    font-size: 10px;
  }
  .trek-card h3 {
    font-size: 22px;
    margin: 8px 0;
  }
  .trek-card p {
    font-size: 13px;
    margin: 0 0 14px;
  }
  .text-link {
    color: var(--pine);
    font-weight: 700;
    font-size: 13px;
  }
  .region-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .region-card {
    min-height: 260px;
    border-radius: 18px;
    background-size: cover;
    background-position: center;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    justify-content: end;
    padding: 22px;
    color: white;
    position: relative;
    overflow: hidden;
  }
  .region-card:before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent, rgba(9, 31, 22, 0.85));
  }
  .region-card > * {
    position: relative;
  }
  .region-card,
  .trek-card {
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }
  .region-card:hover,
  .trek-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 38px rgba(28, 86, 55, 0.13);
  }
  .section-head p,
  .page-hero p {
    max-width: 62ch;
  }
  .menu-toggle iconify-icon {
    display: block;
  }
  .region-card h3 {
    font-size: 22px;
    margin: 0;
  }
  .region-card p {
    color: #e6ede7;
    font-size: 12px;
    margin: 7px 0 0;
  }
  .page-hero {
    padding: 84px clamp(24px, 8vw, 124px) 64px;
    background: var(--sand);
  }
  .page-hero h1 {
    font-size: clamp(40px, 5vw, 64px);
  }
  .page-hero p {
    max-width: 640px;
  }
  .form-control {
    display: block;
    width: 100%;
    min-height: 54px;
    padding: 13px 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: linear-gradient(180deg, var(--white) 0%, var(--sand) 100%);
    color: var(--ink);
    font: 400 15px/1.5 var(--serif);
    box-shadow:
      0 3px 10px rgba(20, 16, 12, 0.035),
      inset 0 1px 0 rgba(255, 255, 255, 0.85);
    box-shadow:
      0 3px 10px rgba(25, 71, 43, 0.035),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
    transition:
      border-color 0.18s ease,
      box-shadow 0.18s ease,
      background 0.18s ease;
  }
  .form-control::placeholder {
    color: var(--muted);
    opacity: 0.72;
  }
  .form-control:hover {
    border-color: var(--ridge-200);
    background: var(--white);
  }
  .form-control:focus {
    outline: none;
    border-color: var(--crimson-500);
    background: var(--white);
    box-shadow:
      0 0 0 4px rgba(143, 10, 11, 0.11),
      0 5px 14px rgba(20, 16, 12, 0.07);
  }
  .form-control:focus-visible {
    outline: none;
  }
  textarea.form-control {
    min-height: 130px;
    resize: vertical;
  }
  select.form-control {
    cursor: pointer;
    padding-right: 42px;
  }
  .filter-bar {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr auto;
    gap: 14px;
    margin: 34px 0;
  }
  .notice {
    padding: 14px 17px;
    background: #f1ead9;
    border-left: 3px solid var(--orange);
    font-size: 13px;
    color: #555;
  }
  .detail-hero {
    height: 430px;
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: end;
    padding: 48px clamp(22px, 8vw, 120px);
    color: white;
    position: relative;
  }
  .detail-hero:before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent, rgba(10, 27, 20, 0.8));
  }
  .detail-hero > * {
    position: relative;
  }
  .detail-hero h1 {
    font-size: clamp(40px, 6vw, 68px);
    max-width: 780px;
  }
  .detail-content {
    max-width: 1080px;
    margin: auto;
    padding: 64px 24px 100px;
  }
  .detail-content h2 {
    font-size: 32px;
    margin-top: 45px;
  }
  .detail-content p {
    max-width: 760px;
  }
  .detail-meta {
    display: flex;
    gap: 24px;
    font-size: 13px;
    color: #e7eee9;
  }
  .faq-item {
    border-bottom: 1px solid var(--line);
    padding: 18px 0;
  }
  .faq-item summary {
    font-weight: 700;
    cursor: pointer;
  }
  .article {
    max-width: 760px;
    margin: auto;
  }
  .article h2 {
    font-size: 30px;
    margin-top: 40px;
  }
  .article p {
    font-size: 17px;
  }
  .empty-state {
    text-align: center;
    padding: 48px;
    border: 1px dashed #b8c5bb;
  }
  .contact-form {
    max-width: 650px;
    display: grid;
    gap: 18px;
  }
  .contact-form label {
    display: block;
    color: var(--pine-900);
    font: 600 13px/1.4 var(--body);
  }
  .filter-bar .form-control {
    min-height: 54px;
  }
  .filter-bar .button {
    align-self: stretch;
  }
  .contact-form input,
  .contact-form textarea,
  .contact-form select {
    display: block;
    margin-top: 6px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 900px) {
    .header {
      height: 76px;
    }
    .menu-toggle {
      display: grid;
      place-items: center;
