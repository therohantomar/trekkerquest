---
import Layout from '../layouts/Layout.astro';import {treks} from '../data/treks';const local=treks.filter(t=>t.state==='Maharashtra');
---
<Layout title="Trek Discovery Near Pune | TrekkersQuest"><section class="page-hero"><span class="eyebrow">CITY GATEWAY · SAMPLE DISCOVERY</span><h1>Explore trail ideas near Pune.</h1><p>Browse Maharashtra trail inspiration. Distances, travel times, access and transport from Pune are unverified; confirm them locally before planning.</p></section><section class="section"><div class="card-grid">{local.map(t=><article class="trek-card"><img src={t.image} alt={`Illustrative landscape for ${t.name}`} loading="lazy"/><div class="trek-card-body"><span class="eyebrow">MAHARASHTRA · SAMPLE</span><h3>{t.name}</h3><p>{t.description}</p><a class="text-link" href={`/treks/${t.slug}/`}>View details ↗</a></div></article>)}</div></section></Layout>
