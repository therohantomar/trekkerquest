---
import Layout from '../layouts/Layout.astro';import {treks} from '../data/treks';const weekend=treks.filter(t=>t.trekType.includes('Weekend'));
---
<Layout title="Weekend Treks in India | TrekkersQuest"><section class="page-hero"><span class="eyebrow">A LITTLE OUTDOORS, A LITTLE OFTEN</span><h1>Weekend trails & escapes.</h1><p>Browse short-trip inspiration in India. No meeting points, transport or departure dates are confirmed on this demo site.</p></section><section class="section"><h2>City gateways</h2><div class="city-links"><a href="/treks-near-mumbai/">Mumbai ↗</a><a href="/treks-near-pune/">Pune ↗</a><a href="/treks-near-bengaluru/">Bengaluru ↗</a><a href="/treks-near-delhi/">Delhi ↗</a></div><h2 style="margin-top:48px">Weekend discovery trails</h2><div class="card-grid">{weekend.map(t=><article class="trek-card"><img src={t.image} alt={`Illustrative landscape for ${t.name}`} loading="lazy"/><div class="trek-card-body"><span class="eyebrow">{t.state} · SAMPLE</span><h3>{t.name}</h3><p>{t.description}</p><a class="text-link" href={`/treks/${t.slug}/`}>Explore trail ↗</a></div></article>)}</div><p class="notice" style="margin-top:30px">This is not a departure schedule. Verify travel time, access, transport and current conditions before planning a weekend visit.</p></section></Layout>
