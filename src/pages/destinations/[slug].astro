---
import Layout from '../../layouts/Layout.astro';import {regions,treks} from '../../data/treks';
export function getStaticPaths(){return regions.map(r=>({params:{slug:r.slug},props:{region:r}}))}
const {region}=Astro.props;const entries=treks.filter(t=>t.region===region.name);
---
<Layout title={`${region.name} Trekking Destinations | TrekkersQuest`}><section class="detail-hero" style={`background-image:url('${region.image}')`}><div><span class="eyebrow" style="color:white">DESTINATION GUIDE · INDIA</span><h1>{region.name}</h1><div class="detail-meta">Discovery category · {entries.length} sample entries</div></div></section><section class="section"><p>{region.description} Conditions and access vary by route and season; this guide is a starting point for discovery, not a live availability listing.</p><h2>Trails in this landscape</h2><div class="card-grid">{entries.map(t=><article class="trek-card"><img src={t.image} alt={`Illustrative landscape for ${t.name}`} loading="lazy"/><div class="trek-card-body"><span class="eyebrow">{t.state} · SAMPLE</span><h3>{t.name}</h3><p>{t.description}</p><a class="text-link" href={`/treks/${t.slug}/`}>View discovery details ↗</a></div></article>)}</div><h2 style="margin-top:48px">Plan with local context</h2><p>Best season, base towns, access routes and permit requirements should be verified for the specific trail with current authoritative sources before planning travel. Respect local communities and protected landscapes.</p><p class="notice">Check current local rules and access before travel. Sample content is not route advice.</p></section></Layout>
