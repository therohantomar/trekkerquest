---
import Layout from '../layouts/Layout.astro';import {treks} from '../data/treks';const local=treks.filter(t=>t.state==='Karnataka');
---
<Layout title="Trek Discovery Near Bengaluru | TrekkersQuest"><section class="page-hero"><span class="eyebrow">CITY GATEWAY · SAMPLE DISCOVERY</span><h1>Explore trail ideas near Bengaluru.</h1><p>Browse Karnataka trail inspiration. Travel distances, timings, transport and access from Bengaluru are not verified in this demo.</p></section><section class="section"><div class="card-grid">{local.map(t=><article class="trek-card"><img src={t.image} alt={`Illustrative landscape for ${t.name}`} loading="lazy"/><div class="trek-card-body"><span class="eyebrow">KARNATAKA · SAMPLE</span><h3>{t.name}</h3><p>{t.description}</p><a class="text-link" href={`/treks/${t.slug}/`}>View details ↗</a></div></article>)}</div></section></Layout>
