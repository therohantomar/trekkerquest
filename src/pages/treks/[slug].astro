---
import Layout from '../../layouts/Layout.astro';import {treks} from '../../data/treks';
export function getStaticPaths(){return treks.map(t=>({params:{slug:t.slug},props:{trek:t}}))}
const {trek}=Astro.props;
---
<Layout title={`${trek.name} | TrekkersQuest`} description={trek.description}><section class="detail-hero" style={`background-image:url('${trek.image}')`}><div><span class="eyebrow" style="color:#fff">{trek.state} · INDIA · SAMPLE LISTING</span><h1>{trek.name}</h1><div class="detail-meta"><span>{trek.region}</span><span>{trek.difficulty}</span></div></div></section><div class="detail-content"><p class="notice">Sample discovery content · Details to be confirmed. This page is not a trip offer or booking. Check current access, local rules and safety conditions before travel.</p><h2>About this trail</h2><p>{trek.description} TrekkersQuest is a discovery platform, not an operator. No itinerary, accommodation, transport, departure date or package is currently confirmed for this sample entry.</p><h2>Know before you go</h2><p>Route distance, duration, altitude, difficulty, best season, permits and base-point information have been left unpublished until verified by the site owner. Consult current local guidance, especially for protected areas, high-altitude routes and seasonal trails.</p><h2>Planning responsibly</h2><ul><li>Confirm route access and any permit requirements with current authoritative sources.</li><li>Check local weather and trail conditions before setting out.</li><li>Use qualified local guidance where required and do not enter restricted terrain.</li><li>Carry out waste and respect local communities and ecosystems.</li></ul><h2>Ask about this trail</h2><p>Ask about current dates and pricing. Submitting the form below prepares a demo enquiry only; it does not contact an operator or reserve a place.</p><form class="contact-form" id="enquiry"><label>Full name<input class="form-control" name="name" required autocomplete="name" /></label><label>Email address<input class="form-control" name="email" type="email" required autocomplete="email" /></label><label>Phone (optional)<input class="form-control" name="phone" type="tel" autocomplete="tel" /></label><label>Message<textarea class="form-control" name="message" rows="4">I’d like to ask about {trek.name}.</textarea></label><button class="button" type="submit">Prepare demo enquiry</button><p id="feedback" role="status" aria-live="polite"></p></form><h2>Related discovery trails</h2><div class="card-grid">{treks.filter(t=>t.slug!==trek.slug&&t.region===trek.region).slice(0,3).map(t=><article class="trek-card"><img src={t.image} alt={`Illustrative landscape for ${t.name}`} loading="lazy"/><div class="trek-card-body"><span class="eyebrow">{t.state}</span><h3>{t.name}</h3><a class="text-link" href={`/treks/${t.slug}/`}>View details ↗</a></div></article>)}</div></div><script is:inline>document.querySelector('#enquiry').addEventListener('submit',e=>{e.preventDefault();const f=e.currentTarget;if(!f.reportValidity())return;document.querySelector('#feedback').textContent='Demo mode: your enquiry has been prepared in this browser only. No real enquiry was sent.';f.reset()})</script></Layout>
