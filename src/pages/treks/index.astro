---
import Layout from '../../layouts/Layout.astro';import {treks} from '../../data/treks';
---
<Layout title="Explore Treks in India | TrekkersQuest"><section class="page-hero"><span class="eyebrow">THE TRAIL STARTS HERE</span><h1>Explore treks across India.</h1><p>Browse India-only trekking destinations. Entries are discovery samples, not confirmed departures; route information should be verified before travel.</p></section><section class="section"><div class="filter-bar"><label class="sr-only" for="search">Search trek, state or region</label><input class="form-control" id="search" placeholder="Search trek, state or region"/><label class="sr-only" for="region">Region</label><select class="form-control" id="region"><option value="">All regions</option>{[...new Set(treks.map(t=>t.region))].map(x=><option>{x}</option>)}</select><label class="sr-only" for="sort">Sort</label><select class="form-control" id="sort"><option value="recommended">Recommended</option><option value="name">Name A–Z</option></select><button class="button" id="clear" type="button">Clear filters</button></div><p id="count" aria-live="polite"></p><div class="card-grid" id="results">{treks.map(t=><article class="trek-card" data-name={t.name.toLowerCase()} data-state={t.state.toLowerCase()} data-region={t.region}><img src={t.image} alt={`Illustrative landscape for ${t.name}`} loading="lazy"/><div class="trek-card-body"><span class="eyebrow">{t.state} · SAMPLE</span><h3>{t.name}</h3><p>{t.description}</p><p><strong>Difficulty:</strong> {t.difficulty}</p><a class="text-link" href={`/treks/${t.slug}/`}>View trek details ↗</a></div></article>)}</div><div class="empty-state" id="empty" hidden><h2>No trails match that search.</h2><p>Try another name, region or state.</p><button class="button" id="reset" type="button">Reset search</button></div><p class="notice" style="margin-top:30px">Demo discovery content only. Current access, permits, weather and route conditions must be checked with authoritative local sources.</p></section>
<script is:inline>
const search=document.querySelector('#search'),region=document.querySelector('#region'),sort=document.querySelector('#sort'),cards=[...document.querySelectorAll('#results .trek-card')],count=document.querySelector('#count'),empty=document.querySelector('#empty');function update(){const q=search.value.toLowerCase(),r=region.value;let visible=cards.filter(c=>(c.dataset.name+' '+c.dataset.state+' '+c.dataset.region.toLowerCase()).includes(q)&&(!r||c.dataset.region===r));if(sort.value==='name')visible.sort((a,b)=>a.dataset.name.localeCompare(b.dataset.name));cards.forEach(c=>c.hidden=!visible.includes(c));visible.forEach(c=>document.querySelector('#results').append(c));count.textContent=`${visible.length} discovery ${visible.length===1?'trail':'trails'}`;empty.hidden=visible.length!==0}search.addEventListener('input',update);region.addEventListener('change',update);sort.addEventListener('change',update);function reset(){search.value='';region.value='';sort.value='recommended';update()}document.querySelector('#clear').addEventListener('click',reset);document.querySelector('#reset').addEventListener('click',reset);update();
</script></Layout>
