---
import Layout from "../../layouts/Layout.astro";
const posts = {
  "first-himalayan-trek": {
    title: "First Himalayan trek: questions to ask before you go",
    category: "Beginner Advice",
    intro:
      "A first mountain trek begins with good questions. Before comparing a route, understand what is known, what is not, and who can confirm the details.",
  },
  "trekking-shoes": {
    title: "Choosing trekking shoes for Indian trails",
    category: "Packing",
    intro:
      "The right footwear is the pair that fits your foot, suits your terrain and is comfortable after a proper break-in—not simply the one with the most features.",
  },
  "sahyadri-monsoon": {
    title: "Monsoon trekking in the Sahyadris: prepare thoughtfully",
    category: "Seasonal Guides",
    intro:
      "Rain transforms the Western Ghats and also changes trail conditions. Always check local access, weather and safety guidance before setting out.",
  },
  "leave-no-trace": {
    title: "Leave no trace on India’s trails",
    category: "Responsible Travel",
    intro:
      "A thoughtful visit starts with respect for local communities, wildlife and the landscape. Plan ahead and leave the place as you found it.",
  },
};
export function getStaticPaths() {
  const entries = [
    [
      "first-himalayan-trek",
      {
        title: "First Himalayan trek: questions to ask before you go",
        category: "Beginner Advice",
        intro:
          "A first mountain trek begins with good questions. Confirm route facts and preparation needs before travel.",
      },
    ],
    [
      "trekking-shoes",
      {
        title: "Choosing trekking shoes for Indian trails",
        category: "Packing",
        intro:
          "Compare fit, grip and comfort for the terrain you plan to explore.",
      },
    ],
    [
      "sahyadri-monsoon",
      {
        title: "Monsoon trekking in the Sahyadris: prepare thoughtfully",
        category: "Seasonal Guides",
        intro:
          "Check local access, weather and safety guidance before setting out.",
      },
    ],
    [
      "leave-no-trace",
      {
        title: "Leave no trace on India’s trails",
        category: "Responsible Travel",
        intro: "Respect local communities, wildlife and the landscape.",
      },
    ],
  ];
  return entries.map(([slug, post]) => ({ params: { slug }, props: { post } }));
}
const { post } = Astro.props as {
  post: { title: string; category: string; intro: string };
};
---

<Layout title={`${post.title} | TrekkersQuest`} description={post.intro}>
  <section class="page-hero">
    <span class="eyebrow">{post.category} · EDITORIAL SAMPLE</span>
    <h1>{post.title}</h1>
    <p>{post.intro}</p>
  </section>
  <article class="section article">
    <p>{post.intro}</p>
    <h2>Start with reliable information</h2>
    <p>
      Ask for the route, expected effort, terrain, total time outdoors and any
      seasonal considerations. If information is missing, treat that as a reason
      to pause and confirm—not a detail to fill in by guesswork.
    </p>
    <h2>Prepare for your own experience</h2>
    <p>
      Consider your recent activity, comfort with uneven ground, weather and the
      time you have. Choose equipment that fits and test it before the day. For
      a demanding or unfamiliar trail, consult qualified local guidance.
    </p>
    <h2>Check conditions close to your trip</h2>
    <p>
      Access, weather and local rules may change. Confirm them with current
      authoritative sources before travel; never enter closed or restricted
      terrain.
    </p>
    <h2>Travel with care</h2>
    <p>
      Respect local customs and communities, keep noise and waste to a minimum,
      and follow current instructions from local authorities and land managers.
    </p>
    <p class="notice">
      Editorial demo content · Not current safety, medical, permit or route
      advice. Last reviewed: not yet reviewed.
    </p>
    <a class="text-link" href="/blog/">
      ← Back to the journal
    </a>
  </article>
</Layout>
